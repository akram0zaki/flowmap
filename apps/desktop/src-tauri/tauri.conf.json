{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Flowmap",
  "version": "0.1.0",
  "identifier": "com.flowmap.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter @flowmap/desktop dev",
    "beforeBuildCommand": "pnpm --filter @flowmap/desktop build"
  },
  "app": {
    "windows": [
      {
        "title": "Flowmap",
        "width": 1280,
        "height": 840,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Visual portfolio control",
    "longDescription": "A management-level model of a delivery portfolio, rendered as a manipulable landscape.",
    "windows": {
      "webviewInstallMode": {
        "type": "skip"
      },
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com"
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "hardenedRuntime": true,
      "entitlements": "Entitlements.plist"
    }
  }
}
